<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.hwyz.iov.cloud.parent</groupId>
        <artifactId>cloud</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>net.hwyz.iov.cloud.framework</groupId>
    <artifactId>framework-common</artifactId>
    <packaging>jar</packaging>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
    </properties>

    <dependencies>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- WEB服务 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web-services</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- WebFlux -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JSON相关 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- Apache Lang3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- Commons Io -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>

        <!-- Jwt -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt</artifactId>
        </dependency>

        <!-- Excel相关 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Parent 全局 surefire skip=true（CI 默认），本模块覆盖为 false 使测试可执行（同 framework-web/mysql 先例，FW-COMMON-DSN-CR-001 TC-07） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
                <executions>
                    <!-- 双 JVM 时区一致性（FW-COMMON-DSN-CR-001 TC-01/TC-07）：
                         UTC 与 Asia/Shanghai 独立 fork 进程重跑 TimezoneInvarianceTest，
                         避免进程内 TimeZone.setDefault 全局时区污染；断言本身与 JVM 时区无关。 -->
                    <execution>
                        <id>tz-utc</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <user.timezone>UTC</user.timezone>
                                <tz.expect>UTC</tz.expect>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/TimezoneInvarianceTest.java</include>
                            </includes>
                            <reportsDirectory>${project.build.directory}/surefire-reports-tz-utc</reportsDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>tz-shanghai</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <user.timezone>Asia/Shanghai</user.timezone>
                                <tz.expect>Asia/Shanghai</tz.expect>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/TimezoneInvarianceTest.java</include>
                            </includes>
                            <reportsDirectory>${project.build.directory}/surefire-reports-tz-shanghai</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>